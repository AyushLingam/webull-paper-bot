# Copy this file to ".env" and fill in your PAPER credentials.
# .env is gitignored. Never commit real keys. Never paste them into a chat.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=

# Optional. Paper/sandbox keys only work against the sandbox host.
# Defaults to api.sandbox.webull.com. Set to api.webull.com for LIVE trading.
WEBULL_API_ENDPOINT=api.sandbox.webull.com
WEBULL_REGION=us
